<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Wallaby</PackageId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Postgres Change Data Capture for .NET: self-configuring logical replication, transforms/enrichment, pluggable destinations, and watermark-coordinated backfill. Pair with a storage provider package such as Wallaby.EntityFrameworkCore.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wallaby.Testing" />
    <InternalsVisibleTo Include="Wallaby.UnitTests" />
    <InternalsVisibleTo Include="Wallaby.IntegrationTests" />
    <InternalsVisibleTo Include="Wallaby.Meilisearch.IntegrationTests" />
    <InternalsVisibleTo Include="Wallaby.TestInfrastructure" />
    <InternalsVisibleTo Include="Wallaby.TestInfrastructure.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Wallaby.EntityFrameworkCore.UnitTests" />
    <InternalsVisibleTo Include="Wallaby.EntityFrameworkCore.IntegrationTests" />
    <InternalsVisibleTo Include="Wallaby.Marten.UnitTests" />
    <InternalsVisibleTo Include="Wallaby.Marten.IntegrationTests" />
    <InternalsVisibleTo Include="Wallaby.TestInfrastructure.Marten" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <Import Project="../../Package.Build.props" />

</Project>
