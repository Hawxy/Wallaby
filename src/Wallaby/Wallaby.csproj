<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Wallaby</PackageId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Postgres Change Data Capture for .NET: self-configuring logical replication, transforms/enrichment, pluggable destinations, and watermark-coordinated backfill. Pair with a storage provider package such as Wallaby.Providers.EntityFrameworkCore.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wallaby.Testing" />
    <InternalsVisibleTo Include="Wallaby.Providers.Marten" />
    <InternalsVisibleTo Include="Wallaby.TestInfrastructure" />
    <InternalsVisibleTo Include="Wallaby.Tests" />
    <InternalsVisibleTo Include="Wallaby.Providers.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="Wallaby.Providers.Marten.Tests" />
    <InternalsVisibleTo Include="Wallaby.Sinks.Meilisearch.Tests" />
    <InternalsVisibleTo Include="Wallaby.AotSmokeTest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DistributedLock.Postgres" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <Import Project="../../Package.Build.props" />

</Project>
