<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Wallaby.Sinks.Pgvector</PackageId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Postgres pgvector destination/sink for Wallaby: sync documents into vector tables, with optional sink-side embedding via Microsoft.Extensions.AI.</Description>
    <PackageTags>pgvector;vector;embeddings;rag;sink</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wallaby.Sinks.Pgvector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wallaby\Wallaby.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Pgvector" />
  </ItemGroup>

  <Import Project="../../Package.Build.props" />
</Project>
