<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Wallaby.Sinks.Kafka</PackageId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Produce Postgres changes to Kafka topics from .NET, with no Debezium and no Kafka Connect. Change data capture sink for Wallaby: one message per record keyed by document id, tombstone deletes, and commit order preserved per document.</Description>
    <PackageTags>kafka;streaming;event-streaming;sink;sync</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wallaby.Sinks.Kafka.Tests" />
    <InternalsVisibleTo Include="Wallaby.AotSmokeTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wallaby\Wallaby.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Dekaf" />
    <PackageReference Include="Dekaf.Compression.Lz4" />
    <PackageReference Include="Dekaf.Compression.Zstd" />
    <PackageReference Include="Dekaf.Compression.Snappy" />
  </ItemGroup>

  <Import Project="../../Package.Build.props" />
</Project>
