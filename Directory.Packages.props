<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core runtime dependencies -->
    <PackageVersion Include="DistributedLock.Postgres" Version="1.3.1" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Marten" Version="9.29.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- Wallaby.Client (control-plane client) -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
    <!-- Pgvector sink package -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <!-- Meilisearch sink package -->
    <PackageVersion Include="Meilisearch" Version="0.20.0" />
    <!-- Kafka sink package -->
    <PackageVersion Include="Dekaf" Version="1.13.0" />
    <PackageVersion Include="Dekaf.Compression.Lz4" Version="1.13.0" />
    <PackageVersion Include="Dekaf.Compression.Zstd" Version="1.13.0" />
    <PackageVersion Include="Dekaf.Compression.Snappy" Version="1.13.0" />
    <!-- Elasticsearch sink package -->
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.5.0" />
    <!-- OpenSearch sink package -->
    <PackageVersion Include="OpenSearch.Client" Version="2.1.0" />
    <!-- Sample / test infrastructure -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Trace demo (tests/Wallaby.TraceDemo only) -->
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageVersion Include="StandardWebhooks" Version="1.1.2" />
    <PackageVersion Include="TUnit" Version="1.65.38" />
    <PackageVersion Include="TUnit.Core" Version="1.65.38" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.14.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>