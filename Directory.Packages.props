<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <PropertyGroup>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-10</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <!-- Aspire 17 needs 10.0.15 on net10.0 and the 11.0 packages on net11.0. -->
  <PropertyGroup>
    <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <!-- net10.0 builds against Npgsql 10 and EF Core 10; net11.0 against Npgsql 11 and EF Core 11 (net11.0-only). -->
  <PropertyGroup>
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <EntityFrameworkCoreVersion>10.0.12</EntityFrameworkCoreVersion>
    <NpgsqlEntityFrameworkCoreVersion>10.0.3</NpgsqlEntityFrameworkCoreVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <NpgsqlVersion>11.0.0</NpgsqlVersion>
    <EntityFrameworkCoreVersion>11.0.0</EntityFrameworkCoreVersion>
    <NpgsqlEntityFrameworkCoreVersion>11.0.0</NpgsqlEntityFrameworkCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core runtime dependencies -->
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Marten" Version="9.46.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <!-- Wallaby.Client (control-plane client) -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Fallout.Common" Version="10.4.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <!-- Pgvector sink package -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <!-- Meilisearch sink package -->
    <PackageVersion Include="Meilisearch" Version="0.20.0" />
    <!-- Kafka sink package -->
    <PackageVersion Include="Dekaf" Version="1.23.1" />
    <PackageVersion Include="Dekaf.Compression.Lz4" Version="1.23.1" />
    <PackageVersion Include="Dekaf.Compression.Zstd" Version="1.23.1" />
    <PackageVersion Include="Dekaf.Compression.Snappy" Version="1.23.1" />
    <!-- Elasticsearch sink package -->
    <PackageVersion Include="Elastic.Ingest.Elasticsearch" Version="0.53.0" />
    <!-- OpenSearch sink package -->
    <PackageVersion Include="OpenSearch.Client" Version="2.2.0" />
    <!-- Aspire hosting package, sample AppHost and its tests -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Meilisearch" Version="17.0.0-beta.1052" />
    <!-- Sample / test infrastructure -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEntityFrameworkCoreVersion)" />
    <!-- Trace demo and the Aspire sample worker -->
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageVersion Include="StandardWebhooks" Version="1.1.2" />
    <PackageVersion Include="TUnit" Version="1.72.16" />
    <PackageVersion Include="TUnit.Core" Version="1.72.16" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.14.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>