<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Marten's document metadata discovery reflects over the document types; keep this assembly's
         members so the smoke exercises Wallaby's code paths rather than trimmer behaviour. -->
    <TrimmerRootAssembly Include="Wallaby.AotSmokeTest" />
    <TrimmerRootAssembly Include="Marten" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wallaby\Wallaby.csproj" />
    <ProjectReference Include="..\..\src\Wallaby.Sinks.Pgvector\Wallaby.Sinks.Pgvector.csproj" />
    <ProjectReference Include="..\..\src\Wallaby.Providers.Marten\Wallaby.Providers.Marten.csproj" />
  </ItemGroup>

</Project>
