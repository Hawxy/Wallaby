<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>wallaby-aspire-sample-apphost</UserSecretsId>
    <!-- Runs with dotnet run and Aspire.Hosting.Testing; the Aspire CLI bundle isn't needed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Meilisearch" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wallaby.Aspire.Hosting\Wallaby.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
